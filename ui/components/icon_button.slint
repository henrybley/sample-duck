import { Palette } from "../palette.slint";

export component IconButton inherits Rectangle {
    in property <string> text;
    in property <image> icon; // optional icon source
    in property <string> tooltip: "";
    in property <color> icon_color;

    callback clicked;


    Image {
        source: root.icon;
        colorize: icon_color;
        x: 3px;
        y: 3px;
        width: parent.width - self.x * 2;
        height: parent.height - self.y * 2;
        visible: true;
    }

    TouchArea {
        clicked => clicked();
        mouse-cursor: MouseCursor.help;
    }
}
