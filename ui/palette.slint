export global Palette {
    in-out property <color> background: #1F2335;
    in-out property <color> surface: #545C7E;
    in-out property <color> primary: #FF9E64;
    in-out property <color> secondary: #9ECE6A;
    in-out property <color> accent: #2AC3DE;
    in-out property <color> error: #FF6B81;
    in-out property <color> foreground: #888888;
    in-out property <color> selected: #3A3A3A;
}
